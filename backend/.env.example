# ============================================================================
# RCA Agentic SOC — Environment Variables Template
# ============================================================================
# Copy this file to .env and fill in your own values.
# NEVER commit the real .env file to version control.
#
#   cp backend/.env.example backend/.env
#
# Keys can be generated with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ============================================================================

# Required: Fernet key for the encrypted inter-agent Event Bus.
# Generate with the command above.
SOC_BUS_KEY=

# Required: Fernet key for the encrypted Vault (secrets store).
# Generate with the command above.
SOC_VAULT_KEY=

# Optional: Override the auto-generated JWT secret key used by the API.
# If not set, a random key is generated at startup (keys will not persist across restarts).
# SOC_API_SECRET_KEY=
