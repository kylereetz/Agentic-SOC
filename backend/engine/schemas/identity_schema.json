{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Identity Event Schema",
  "type": "object",
  "properties": {
    "timestamp": { "type": "string", "format": "date-time" },
    "event_type": { 
      "type": "string", 
      "enum": ["login_success", "login_failure", "mfa_success", "mfa_failure", "token_refresh"] 
    },
    "user_id": { "type": "string" },
    "source_ip": { "type": "string" },
    "location": {
      "type": "object",
      "properties": {
        "city": { "type": "string" },
        "country": { "type": "string" },
        "lat": { "type": "number" },
        "lon": { "type": "number" }
      }
    },
    "user_agent": { "type": "string" },
    "mfa_method": { "type": "string" }
  },
  "required": ["timestamp", "event_type", "user_id", "source_ip"]
}
