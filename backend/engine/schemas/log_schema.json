{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Raw Log Schema",
  "type": "object",
  "properties": {
    "timestamp": { "type": "string", "format": "date-time" },
    "source": { "type": "string" },
    "raw_data": { "type": "string" },
    "format": { "type": "string", "default": "unknown" }
  },
  "required": ["timestamp", "source", "raw_data"]
}
