  const activeAgents = agents.filter(a => a.status === 'ACTIVE').length;
  const firstPending = pendingActions[0];

  const currentTimestamp = (() => {
    const base = new Date('2023-10-24T12:00:00Z');
    const msAdded = (replayProgress / 100) * (2 * 60 * 60 * 1000 + 45 * 60 * 1000);
    const t = new Date(base.getTime() + msAdded);
    return t.toISOString().replace('T', ' ').slice(0, 19) + ' UTC';
  })();

  return (
    <div className="flex items-center gap-3 px-3 h-full border-t"
