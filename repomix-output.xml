            return {
                "format": "access_log",
                "source_ip": "10.0.0.1", # Mocked extraction
                "message": "User login attempt noted."
            }
        elif "connection" in raw and "refused" in raw:
             return {
                "format": "syslog",
                "source_ip": "192.168.1.100",
                "message": "Outbound connection refused."
            }
        return {
            "format": "generic",
            "message": raw[:100]
        }

