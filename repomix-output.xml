        }}>
        {isUser
          ? <User size={12} style={{ color: '#3B6FE3' }} />
          : <Bot  size={12} style={{ color: '#D84C7F' }} />}
      </div>

      {/* Bubble */}
      <div className={`flex-1 max-w-[86%] ${isUser ? 'items-end' : 'items-start'} flex flex-col gap-1.5`}>
