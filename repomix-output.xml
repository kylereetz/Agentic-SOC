          <span>2023-10-24 12:00:00 UTC</span>
          <span style={{ color: '#3B6FE3' }}>CURRENT: {currentTimestamp}</span>
          <span>REALTIME</span>
        </div>
      </div>

      {/* Live stats */}
      <div className="flex items-center gap-3 flex-shrink-0">
