    event = {
        "timestamp": datetime.now(timezone.utc).isoformat(),
        "incident_id": incident_id,
        "loss_estimate": loss_estimate,
        "criticality": criticality,
        "summary": summary,
        "type": "fiscal_impact"
    }
    business_bus.push(event)
