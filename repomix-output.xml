      setLoading(false);
    }, 900 + Math.random() * 400);
  };

  return (
    <div className="flex flex-col h-full" style={{ background: '#080d14' }}>

      {/* Header */}
      <div
        className="flex items-center gap-2.5 px-4 py-2.5 border-b flex-shrink-0"
