{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SBOM Schema",
  "type": "object",
  "properties": {
    "timestamp": { "type": "string", "format": "date-time" },
    "asset_id": { "type": "string" },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "version": { "type": "string" },
          "type": { "type": "string", "enum": ["library", "application", "operating-system"] },
          "purl": { "type": "string" },
          "dependencies": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "required": ["name", "version", "type"]
      }
    }
  },
  "required": ["timestamp", "asset_id", "components"]
}
